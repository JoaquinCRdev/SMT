# ---------------------------------------------------------------------------
# Copiar a .env y completar con los valores reales. NUNCA commitear el .env.
#
#   cp .env.example .env
#
# Lo que sigue son valores de ejemplo. Los marcados como REQUERIDO no tienen
# fallback en el código: si faltan, la app no arranca o la función falla.
# ---------------------------------------------------------------------------

# --- Servidor ---------------------------------------------------------------

# Puerto del API. Opcional, default 3000.
PORT=3000

# REQUERIDO. String de conexión a MongoDB.
#
# OJO con el formato: el nombre de la base va DESPUÉS de la "/", en la misma
# línea. Si se parte en dos líneas, dotenv corta el valor y la conexión cae
# silenciosamente a la base "test".
#
#   bien:  mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/smt?appName=smt
#   mal:   mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/?
#          appName=smt          <-- esto ya no es parte de la URI
#
# Para desarrollo se está usando la base "test". Cuando haga falta producción,
# cambiar el nombre en la misma línea y apuntar al cluster correspondiente.
MONGO_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/test?appName=smt

# Origen del front permitido por CORS. REQUERIDO.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Seguridad
#
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Cambiarlos invalida las sesiones abiertas y los tokens de reset de contraseña
# emitidos con los valores anteriores.
# ---------------------------------------------------------------------------

# Rondas de bcrypt para el hash de contraseñas. Opcional, default 10.
SALT_ROUNDS=10

# REQUERIDO. Firma los access tokens.
JWT_SECRET=cambiar_por_un_valor_aleatorio

# REQUERIDO. Firma los refresh tokens. Tiene que ser distinto del anterior.
JWT_REFRESH_SECRET=cambiar_por_otro_valor_aleatorio

# ---------------------------------------------------------------------------
# Envío de emails (reset de contraseña)
#
# Para Gmail hace falta una "contraseña de aplicación", no la contraseña de la
# cuenta: Google Account > Security > 2-Step Verification > App passwords.
# ---------------------------------------------------------------------------

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=correo-de-la-app@gmail.com
EMAIL_PASS=app-password-aqui
EMAIL_FROM=correo-de-la-app@gmail.com

# Base para armar los links del email de reset.
# El código concatena "/reset-password?token=...", sin slash final.
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Avisos de mantenimiento (opcionales, tienen default)
# ---------------------------------------------------------------------------

# Zona horaria del taller. El cron usa ESTA zona para la hora y la ventana de
# aviso se calcula en la misma zona, así el aviso no se corre un día.
# Es la que hace que un plan que vence "hoy" no aparezca como "vence en 1 día".
# Default: America/Buenos_Aires
NOTIFICATION_TIMEZONE=America/Buenos_Aires

# A qué hora corre el aviso, en la zona de arriba. Default: 0 8 * * * (08:00).
NOTIFICATION_CRON=0 8 * * *

# Días de anticipación para los planes de periodicidad personalizada
# (trimestral, semestral y "cada N días"). Default: 3.
#
# Las frecuencias nativas traen su propia ventana y no usan esta variable:
#   daily 1 | weekly 2 | monthly 5 | yearly 7
NOTIFICATION_LOOKAHEAD_DAYS=3

# ---------------------------------------------------------------------------
# NODE_ENV no va acá: lo pone el tooling (npm test, npm run dev).
# ---------------------------------------------------------------------------