# ---------------------------------------------------------------------------
# Copiar a .env y completar con la URL real del API. NUNCA commitear el .env.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Base URL del API, con /api al final.
#
# Vite expone al navegador SOLO las variables con prefijo VITE_. Sin ese
# prefijo la variable no existe del lado del cliente.
#
# Desarrollo: el server corre en 3000 (ver server/.env.example, PORT).
VITE_API_URL=http://localhost:3000/api